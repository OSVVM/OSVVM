OSVVM_HEADER_PREFIX: " " 
OSVVM_HEADER_SUFFIX: "*" 
OSVVM_LINE_LENGTH: 162 
OSVVM_LINE_WRAP: 162 
OSVVM_DEFAULT_TIME_UNITS: 1 ns 
OSVVM_DIGITS_FOR_TIME_FRACTION: 3 
OSVVM_MAX_DIGITS_FOR_FIXED_POINT_REAL: 8 
OSVVM_DIGITS_FOR_REAL_FRACTION: 4 
OSVVM_MAX_TIME_DECIMAL_DIGITS: 22 
ALERT_LOG_DEFAULT_PASSED_GOAL: 1 
COVERAGE_REQUIREMENT_BY_BIN: TRUE 
RANDOM_USE_NEW_SEED_METHODS: IfElse(OSVVM_SETTINGS_REVISION >= "2024", TRUE, FALSE) 
SCOREBOARD_YAML_IS_BASE_FILE_NAME: IfElse(OSVVM_SETTINGS_REVISION >= "2024", TRUE, FALSE) 
COVERAGE_DEFAULT_WEIGHT_MODE: IfElse(OSVVM_SETTINGS_REVISION >= "2024", string'("REMAIN"), "AT_LEAST") 
COVERAGE_USE_NEW_SEED_METHODS: TRUE 
COVERAGE_WRITE_PASS_FAIL: FALSE 
COVERAGE_WRITE_BIN_INFO: TRUE 
COVERAGE_WRITE_COUNT: TRUE 
COVERAGE_WRITE_ANY_ILLEGAL: FALSE 
ALERT_LOG_GLOBAL_ALERT_ENABLE: TRUE 
ALERT_LOG_IGNORE_SPACES: FALSE 
ALERT_LOG_IGNORE_EMPTY_LINES: FALSE 
ALERT_LOG_STOP_COUNT_FAILURE: 1 
ALERT_LOG_STOP_COUNT_ERROR: integer'high 
ALERT_LOG_STOP_COUNT_WARNING: integer'high 
LOG_ENABLE_INFO: FALSE 
LOG_ENABLE_DEBUG: FALSE 
LOG_ENABLE_PASSED: FALSE 
LOG_ENABLE_FINAL: FALSE 
ALERT_LOG_FAIL_ON_WARNING: TRUE 
ALERT_LOG_FAIL_ON_DISABLED_ERRORS: TRUE 
ALERT_LOG_FAIL_ON_REQUIREMENT_ERRORS: TRUE 
ALERT_LOG_FAIL_ON_VHDL_ASSERT_ERRORS: IfElse(OSVVM_SETTINGS_REVISION >= "2026", TRUE, FALSE) 
ALERT_LOG_PRINT_VHDL_ASSERT_ERRORS: IfElse(OSVVM_SETTINGS_REVISION >= "2026", TRUE, FALSE) 
ALERT_LOG_WRAP: FALSE 
ALERT_LOG_WRAP_INDENT_CHAR: '<' 
ALERT_LOG_WRAP_END_CHAR: '>' 
ALERT_LOG_INDENTED_LENGTH: 21 
ALERT_LOG_JUSTIFY_ENABLE: IfElse(OSVVM_SETTINGS_REVISION >= "2024", TRUE, FALSE) 
ALERT_LOG_TIME_JUSTIFY_AMOUNT: IfElse(OSVVM_SETTINGS_REVISION >= "2026.08", 16, IfElse(OSVVM_SETTINGS_REVISION >= "2024", 9, 0)) 
ALERT_LOG_DIGITS_FOR_TIME_FRACTION: 1 
ALERT_LOG_DIGITS_FOR_REAL_FRACTION: OSVVM_DIGITS_FOR_REAL_FRACTION 
ALERT_LOG_WRITE_ERRORCOUNT: FALSE 
ALERT_LOG_WRITE_TIME_FIRST: IfElse(ALERT_LOG_WRAP, TRUE, IfElse(OSVVM_SETTINGS_REVISION >= "2024", TRUE, FALSE)) 
ALERT_LOG_WRITE_NAME: TRUE 
ALERT_LOG_WRITE_LEVEL: TRUE 
ALERT_LOG_WRITE_TIME: TRUE 
ALERT_LOG_ID_SEPARATOR: ": " 
ALERT_LOG_SPACES_BEFORE_ALERT: IfElse(OSVVM_SETTINGS_REVISION >= "2026.08", " ", "   ") 
ALERT_LOG_SPACES_BEFORE_LEVEL: IfElse(OSVVM_SETTINGS_REVISION >= "2026.08", " ", "  ") 
ALERT_LOG_SPACES_BEFORE_ID_NAME: IfElse(OSVVM_SETTINGS_REVISION >= "2026.08", "",  "  ") 
ALERT_LOG_REPORT_HIERARCHY: TRUE 
ALERT_LOG_PRINT_PASSED: TRUE 
ALERT_LOG_PRINT_AFFIRMATIONS: FALSE 
ALERT_LOG_PRINT_DISABLED_ALERTS: FALSE 
ALERT_LOG_PRINT_REQUIREMENTS: FALSE 
ALERT_LOG_PRINT_IF_HAVE_REQUIREMENTS: TRUE 
OSVVM_PRINT_PREFIX: "%% " 
OSVVM_SECONDARY_PREFIX: "%%> " 
OSVVM_BLANK_LINE_PREFIX: IfElse(OSVVM_SETTINGS_REVISION >= "2026.08", OSVVM_PRINT_PREFIX, "") 
OSVVM_PREFIX_X_MARKS_THE_SPOT: "%%+ " 
OSVVM_PASS_NAME: "PASSED" 
OSVVM_FAIL_NAME: "FAILED" 
COVERAGE_PRINT_PREFIX: OSVVM_PRINT_PREFIX 
COVERAGE_PASS_NAME: OSVVM_PASS_NAME 
COVERAGE_FAIL_NAME: OSVVM_FAIL_NAME 
ALERT_LOG_PRINT_PREFIX: OSVVM_PRINT_PREFIX 
ALERT_LOG_PASS_NAME: OSVVM_PASS_NAME 
ALERT_LOG_FAIL_NAME: OSVVM_FAIL_NAME 
ALERT_LOG_ALERT_NAME: "Alert" 
ALERT_LOG_LOG_NAME: "Log  " 
ALERT_LOG_DONE_NAME: "DONE " 
ALERT_LOG_NOCHECKS_NAME: "NOCHECKS" 
ALERT_LOG_MANUALCHECKS_NAME: "MANUALCHECKS" 
ALERT_LOG_TIMEOUT_NAME: "TIMEOUT" 
ALERT_LOG_STOPLIMIT_NAME: "STOPLIMIT" 
